# Copy this file to `.env` and fill in your own paths. `.env` is git-ignored (never commit it).
# Nothing here is secret; these are per-machine paths used by the tools and the mod docs.

# JDK 21 used by Gradle (NeoForge 1.21.1)
JAVA_HOME=C:\Program Files\Microsoft\jdk-21.0.12.101-hotspot

# Headless browser for tools\cdp.ps1 (viewer tests)
BRAVE_EXE=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe

# Your Minecraft instance mods folder (install target for the built jar)
MC_MODS_DIR=%APPDATA%\ModrinthApp\profiles\SuperPowers test 1.0.0\mods
