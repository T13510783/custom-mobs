# Normalize text files to LF in the repo (Windows + Mac + Linux teammates, no line-ending diffs)
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never diff or merge as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ogg  binary
*.mp3  binary
*.mp4  binary
*.jar  binary
*.zip  binary
*.bbmodel text eol=lf
